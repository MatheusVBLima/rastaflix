# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# clerk configuration (can include secrets)
/.clerk/

.env.local
.claude/*

# supabase cli local state
supabase/.temp
supabase/.branches
# configs pessoais de editor/IA (cada dev mantém a sua)
.mcp.json
.cursor/

# o exemplo de env é versionado
!.env.example
