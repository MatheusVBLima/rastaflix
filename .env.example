# Copie para .env.local e preencha. Nunca commite o .env.local.

# --- Obrigatórias ---------------------------------------------------------

# URL pública do site (usada em metadata/OG). Em dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: rode `npx supabase start` e copie os valores que ele imprimir
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave service_role (só no servidor; usada pelas escritas do admin)
SUPABASE_SERVICE_ROLE_KEY=

# Clerk: crie uma aplicação grátis em https://dashboard.clerk.com (instância de desenvolvimento)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# --- Opcionais (a feature correspondente fica desligada sem elas) -----------

# PostHog (analytics)
NEXT_PUBLIC_POSTHOG_KEY=

# Indicador de live da Twitch e webhooks
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_EVENTSUB_SECRET=

# Indicador de live da Kick
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# Text-to-speech dos esculachos (/api/tts)
GOOGLE_AI_API_KEY=
